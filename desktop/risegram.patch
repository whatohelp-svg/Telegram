+QPixmap IssuerBadges(bool rise, bool major, int size, qreal ratio) {
+	const auto width = size * (int(rise) + int(major));
+	QPixmap pixmap(qRound(width * ratio), qRound(size * ratio));
+	pixmap.setDevicePixelRatio(ratio);
+	pixmap.fill(Qt::transparent);
+	QPainter painter(&pixmap);
+	painter.setRenderHint(QPainter::Antialiasing);
+	painter.scale(size / 24., size / 24.);
+	const auto draw = [&](bool crown) {
+		QPolygonF seal;
+		for (int i = 0; i < 96; ++i) {
+			const auto angle = i * 6.283185307179586 / 96.;
+			const auto radius = 10.4 + .8 * std::cos(10 * angle);
+			seal << QPointF(12 + radius * std::cos(angle), 12 + radius * std::sin(angle));
+		}
+		painter.setPen(Qt::NoPen);
+		painter.setBrush(crown ? QColor(255, 202, 69) : QColor(34, 158, 217));
+		painter.drawPolygon(seal);
+		if (crown) {
+			painter.setBrush(QColor(38, 52, 66));
+			painter.drawPolygon(QPolygonF{ QPointF(5, 8), QPointF(9, 11),
+				QPointF(12, 6), QPointF(15, 11), QPointF(19, 8),
+				QPointF(17, 17), QPointF(7, 17) });
+		} else {
+			painter.setPen(QPen(Qt::white, 2.1, Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin));
+			painter.drawPolyline(QPolygonF{ QPointF(6.5, 12), QPointF(10, 15.5), QPointF(17.5, 8) });
+		}
+		painter.translate(24, 0);
+	};
+	if (rise) draw(false);
+	if (major) draw(true);
+	return pixmap;
+}
+
